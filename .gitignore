*.runtimeconfig.dev.json
*.csproj.nuget.dgspec.json
*.csproj.nuget.g.props
*.csproj.nuget.g.targets
*.assets.cache
*.nuget.cache
project.lock.json
*.nupkg
*.snupkg
*.symbols.nupkg
*.nuget.props
*.nuget.targets

