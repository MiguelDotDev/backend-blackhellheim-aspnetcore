# -----------------------------------------------------------------------------
# 3. Visual Studio Code / C# Dev Kit local and machine-specific files
#    Shareable .vscode/settings.json, extensions.json, launch.json and
#    tasks.json are intentionally left tracked/untracked-eligible.
# -----------------------------------------------------------------------------
.vscode/.history/
.vscode/*.log
.vscode/settings.local.json
.vscode/http-client.private.env.json
.vscodecsdt/Runners/

# -----------------------------------------------------------------------------
# 4. Environment files and local secrets
#    .env.example and equivalent templates are explicitly allowed.
# -----------------------------------------------------------------------------
.env
.env.*
*.env
*.env.local
!.env.example
!.env.sample
!.env.template
secrets.json
*.secrets.json

# -----------------------------------------------------------------------------
# 5. Local configuration and development overrides
#    appsettings.json, appsettings.Development.json and launchSettings.json
#    are shared configuration and remain version-controlled.
# -----------------------------------------------------------------------------
appsettings.Local.json
appsettings.local.json
appsettings.*.local.json
launchSettings.Local.json
launchSettings.local.json
*.local.json

